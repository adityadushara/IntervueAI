# ==============================================================================
# IntervueAI — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. For local development: copy this file to `.env.local`
# 2. For Vercel deployments: configure these variables in the Vercel Dashboard
#    (Settings -> Environment Variables) scoped to Production, Preview, or Development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Configuration (Required)
# ------------------------------------------------------------------------------
# Public / Client-Safe Keys (Accessible in browser and server)
# Target: Development, Preview, Production
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Legacy Alias (Optional, for backward compatibility)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Server-Only Secret Keys (DO NOT expose to client / browser bundle)
# Target: Development, Preview, Production
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Legacy Secret Alias (Optional, for backward compatibility)
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# ------------------------------------------------------------------------------
# 2. Google Gemini AI Configuration (Required, Server-Only)
# ------------------------------------------------------------------------------
# Google Gen AI SDK API Key (from Google AI Studio)
# Target: Development, Preview, Production
GEMINI_API_KEY=your-gemini-api-key

# Gemini Model Identifier (e.g., gemini-2.5-flash, gemini-3.8-flash)
# Target: Development, Preview, Production
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. Application Canonical URL (Optional)
# ------------------------------------------------------------------------------
# Canonical application base URL used for invitation link generation.
# If omitted, defaults dynamically to window.location.origin (supports preview deployments).
# Target: Production (e.g. https://intervue.ai), Preview (omit or set per-branch)
NEXT_PUBLIC_APP_URL=https://intervueai.vercel.app

# ------------------------------------------------------------------------------
# 4. Production Security & Policy Enforcement Flags (Optional)
# ------------------------------------------------------------------------------
# Target: Production (Recommended 'true'), Preview / Development (Optional 'false')

# Enforce strict recruiter authentication and reject mock/development bypasses
ENFORCE_STRICT_AUTH=true

# Enforce strict distributed database rate limiting; reject requests if rate-limit fails
ENFORCE_STRICT_RATE_LIMIT=true

# Enforce strict Gemini evaluations; prohibit synthetic mock fallback scores in production
ENFORCE_STRICT_EVALUATION=true
